#!/bin/sh

set -e

echo "==> Installing required packages"
PKG_LIB=""
PKG_DEV="bash curl"
docker-install -r -u  ${PKG_LIB} ${PKG_DEV}
echo "==> OK"
echo

echo "==> Installing filebrowser"
curl -fsSL https://filebrowser.xyz/get.sh | bash
echo "==> OK"
echo

echo "==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "==> OK"
echo

echo "==> Setting basic configurations"
mkdir -p /conf.d /conf.d/filebrowser /data
echo "==> OK"
echo

